# ---------------------------------------------------------------------------
# Neon Postgres
# Dashboard -> your project -> Connection Details -> "Pooled connection"
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Shared secret the LAN print agent uses to claim print jobs.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
PRINT_AGENT_TOKEN="change-me-to-a-long-random-string"

# ---------------------------------------------------------------------------
# Secret used to sign the short-lived admin (settings screen) session cookie.
# Generate the same way as above.
# ---------------------------------------------------------------------------
ADMIN_SESSION_SECRET="change-me-to-another-long-random-string"
