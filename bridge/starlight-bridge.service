# systemd unit for the print bridge.
#
#   1. Replace USERNAME below with the Pi's login user (Raspberry Pi Imager
#      makes you choose one — it is no longer always "pi").
#   2. sudo cp starlight-bridge.service /etc/systemd/system/
#      sudo systemctl daemon-reload
#      sudo systemctl enable --now starlight-bridge
#   3. journalctl -u starlight-bridge -f      # live log
[Unit]
Description=Bethel Starlight print bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=USERNAME
WorkingDirectory=/home/USERNAME/starlight-bridge
ExecStart=/usr/bin/node bridge.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
